From 55bfbca76e2e162ff003af2314f394deec5c3f57 Mon Sep 17 00:00:00 2001
From: mwlaboratories <info@mwlabs.be>
Date: Fri, 20 Nov 2026 12:18:02 +0100
Subject: [PATCH 8/8] ipa: Log autofocus activity at info level

Log the initial AF mode and lens range, mode changes, scan start and result, and every lens movement at info level, so that AF can be followed in the logs of an application such as WirePlumber.
---
 src/ipa/libipa/af_contrast.cpp   | 10 +++++++---
 src/ipa/simple/algorithms/af.cpp |  4 +++-
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/src/ipa/libipa/af_contrast.cpp b/src/ipa/libipa/af_contrast.cpp
index 0544baf..8a35cde 100644
--- a/src/ipa/libipa/af_contrast.cpp
+++ b/src/ipa/libipa/af_contrast.cpp
@@ -228,6 +228,10 @@ int AfContrast::init(const ValueNode &tuningData,
 	parseTuning(tuningData);
 	setMode(initialMode_);
 
+	LOG(AfContrast, Info)
+		<< "Focus lens " << lensMin_ << ".." << lensMax_
+		<< ", initial mode " << mode_;
+
 	Pwl::Interval limits = map_.domain();
 
 	controls[&controls::AfMode] =
@@ -459,7 +463,7 @@ void AfContrast::setMode(controls::AfModeEnum mode)
 	if (mode == mode_)
 		return;
 
-	LOG(AfContrast, Debug) << "Mode " << mode_ << " -> " << mode;
+	LOG(AfContrast, Info) << "Mode " << mode_ << " -> " << mode;
 
 	mode_ = mode;
 	pauseFlag_ = false;
@@ -667,7 +671,7 @@ void AfContrast::startScan()
 		target_ = range.focusMin;
 	}
 
-	LOG(AfContrast, Debug)
+	LOG(AfContrast, Info)
 		<< "Start scan at " << target_ << ", step " << scanStep_;
 }
 
@@ -750,7 +754,7 @@ void AfContrast::finishScan(double contrast, double average, double exposure)
 	lastExposure_ = exposure;
 	sceneChangeFrame_.reset();
 
-	LOG(AfContrast, Debug)
+	LOG(AfContrast, Info)
 		<< "Scan " << (focused ? "focused" : "failed") << " at " << position_
 		<< ", contrast " << contrast << " (range " << scanMinContrast_
 		<< " - " << scanMaxContrast_ << ")";
diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
index e04c496..d4d52ab 100644
--- a/src/ipa/simple/algorithms/af.cpp
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -150,8 +150,10 @@ void Af::process(IPAContext &context, const uint32_t frame,
 	const double exposure = frameContext.sensor.exposure * frameContext.sensor.gain;
 	af_.process(frame, frameContext.af, regions, exposure, metadata);
 
-	if (std::optional<int32_t> setting = af_.lensSetting())
+	if (std::optional<int32_t> setting = af_.lensSetting()) {
+		LOG(IPASoftAf, Info) << "Frame " << frame << ": lens to " << *setting;
 		context.activeState.lens.focusPosition = *setting;
+	}
 }
 
 REGISTER_IPA_ALGORITHM(Af, "Af")
