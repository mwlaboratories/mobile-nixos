From 160eae84d50c76352ae54090ab100eab028bbac5 Mon Sep 17 00:00:00 2001
From: mwlaboratories <noreply@example.invalid>
Date: Fri, 20 Nov 2026 17:53:56 +0100
Subject: [PATCH 12/12] ipa: simple: Add colour correction matrices for the
 IMX519

Without a CCM the soft ISP only applies AWB gains to the raw sensor
colours, which are washed out. Use the CCMs of the Raspberry Pi tuning
for the Arducam IMX519 module (same sensor; the OnePlus factory matrices
are close to them).

Measured on the OnePlus 6 main camera, same scene at 720p: mean
saturation 0.094 -> 0.152 (90th percentile 0.239 -> 0.380), grey
balance unchanged (mean RGB 105.8/105.4/105.1 -> 105.5/105.1/104.0).
---
 src/ipa/simple/data/imx519.yaml | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/src/ipa/simple/data/imx519.yaml b/src/ipa/simple/data/imx519.yaml
index e06be8e..ec2ec64 100644
--- a/src/ipa/simple/data/imx519.yaml
+++ b/src/ipa/simple/data/imx519.yaml
@@ -5,6 +5,33 @@ version: 1
 algorithms:
   - BlackLevel:
   - Awb:
+  # Colour correction matrices of the IMX519 from the Raspberry Pi tuning
+  # for the Arducam IMX519 module (raspberrypi/libcamera
+  # src/ipa/rpi/vc4/data/imx519.json, BSD-2-Clause), one per colour
+  # temperature (the 2920 K duplicate left out). The GPU debayer applies
+  # them combined with the AWB gains, at no extra cost.
+  - Ccm:
+      ccms:
+        - ct: 2890
+          ccm: [ 1.36754, -0.18448, -0.18306,
+                 -0.32356, 1.44826, -0.12471,
+                 -0.00412, -0.69936, 1.70348 ]
+        - ct: 3550
+          ccm: [ 1.42836, -0.27235, -0.15601,
+                 -0.28751, 1.41075, -0.12325,
+                 -0.01812, -0.54849, 1.56661 ]
+        - ct: 4500
+          ccm: [ 1.36328, -0.19569, -0.16759,
+                 -0.25254, 1.52248, -0.26994,
+                 -0.01575, -0.53155, 1.54729 ]
+        - ct: 5700
+          ccm: [ 1.49207, -0.37245, -0.11963,
+                 -0.21493, 1.40005, -0.18512,
+                 -0.03781, -0.38779, 1.42561 ]
+        - ct: 7900
+          ccm: [ 1.34849, -0.05425, -0.29424,
+                 -0.22182, 1.77684, -0.55502,
+                 -0.07403, -0.55336, 1.62739 ]
   - Adjust:
   - Agc:
   # The IMX519 modules seen with the simple pipeline handler (OnePlus 6/6T)
