--- a/ucm2/OnePlus/enchilada/VoiceCall.conf
+++ b/ucm2/OnePlus/enchilada/VoiceCall.conf
@@ -49,11 +49,14 @@
 	Comment "Earpiece"
 
 	EnableSequence [
+		# Call audio to the earpiece (back from the speaker)
+		cset "name='SLIMBUS_0_RX Voice Mixer VoiceMMode1' 1"
 		cset "name='RX INT0_1 MIX1 INP0' RX0"
 	]
 
 	DisableSequence [
 		cset "name='RX INT0_1 MIX1 INP0' ZERO"
+		cset "name='SLIMBUS_0_RX Voice Mixer VoiceMMode1' 0"
 	]
 
 	Value {
@@ -63,6 +66,31 @@
 	}
 }
 
+# Speakerphone: call audio to the MAX98927 amp on QUAT_MI2S_RX. Same PCM
+# as the earpiece, so both are ports of one sink (what callaudiod
+# switches). Moving a running call between ports needs the kernel patch
+# "ASoC: qdsp6: q6voice: move a running call to a new port".
+SectionDevice."Speaker" {
+	Comment "Speaker"
+
+	EnableSequence [
+		cset "name='QUAT_MI2S_RX Voice Mixer VoiceMMode1' 1"
+		cset "name='QUAT_MI2S_RX Audio Mixer MultiMedia1' 1"
+		cset "name='Amp DSP Switch' 1"
+	]
+
+	DisableSequence [
+		cset "name='Amp DSP Switch' 0"
+		cset "name='QUAT_MI2S_RX Audio Mixer MultiMedia1' 0"
+		cset "name='QUAT_MI2S_RX Voice Mixer VoiceMMode1' 0"
+	]
+
+	Value {
+		PlaybackPriority 100
+		PlaybackPCM "hw:${CardId},0" # MultiMedia1
+	}
+}
+
 SectionDevice."Mic" {
 	Comment "Bottom Microphone"
 
