From: mwlaboratories <info@mwlabs.be>
Subject: [PATCH] media: i2c: imx371: add a 2x2 binned full field of view mode

The IMX371 front camera of the OnePlus 6 only had its 4656x3456 full
resolution mode. The IMX371 is a quad Bayer sensor: at full resolution
it delivers 2x2 same-colour cells that need a remosaic step (the stock
camera ships a Sony remosaic library for it), so a plain Bayer debayer
of that mode shows a regular colour lattice and looks soft. The full
mode also runs at about 24 fps and costs the soft ISP four times the
pixels.

Add the 2304x1728 mode the stock camera uses for preview and video:
2x2 binning over the whole pixel array, an ordinary Bayer image, line
length 3488, frame length 2544, 798 Mbps per lane (link frequency
399 MHz, pixel rate 319.2 MHz). The register values come from the stock
camera module configuration (com.qti.sensormodule.liteon_imx371). The
binned mode also enables the mapped couplet correction (0x0B05/0x0B06),
as stock does.

The mode needs the 399 MHz link frequency in the firmware; modes whose
link frequency the endpoint doesn't list are not offered. List it in the
OnePlus 6/6T device tree.

Status: hypothesis until tested on the OnePlus 6 (compile-tested).
---
diff --git a/drivers/media/i2c/imx371.c b/drivers/media/i2c/imx371.c
index 1fd750e..f668477 100644
--- a/drivers/media/i2c/imx371.c
+++ b/drivers/media/i2c/imx371.c
@@ -25,6 +25,10 @@
 
 /* HBLANK control - read only */
 #define IMX371_PPL_DEFAULT		6032
+#define IMX371_PPL_BINNED		3488
+
+/* Frame length of the 2x2 binned mode */
+#define IMX371_VTS_BINNED		2544
 
 /* Exposure control */
 #define IMX371_EXPOSURE_OFFSET		10
@@ -107,6 +111,22 @@ struct imx371_mode {
 	struct v4l2_rect crop;
 };
 
+/* 798 Mbps per lane (link frequency 399 MHz), for the 2x2 binned mode */
+static const struct cci_reg_sequence mipi_798mbps_24mhz_4l[] = {
+	{ CCS_R_EXTCLK_FREQUENCY_MHZ, 0x1800 },
+	{ CCS_R_VT_PIX_CLK_DIV, 5 },
+	{ CCS_R_VT_SYS_CLK_DIV, 4 },
+	{ CCS_R_PRE_PLL_CLK_DIV, 4 },
+	{ CCS_R_PLL_MULTIPLIER, 222 },
+	{ CCS_R_OP_SYS_CLK_DIV, 2 },
+	{ CCS_R_OP_PRE_PLL_CLK_DIV, 4 },
+	{ CCS_R_OP_PLL_MULTIPLIER, 266 },
+	{ CCS_R_PLL_MODE, 1 },
+	{ CCS_R_CSI_LANE_MODE, 3 },
+	{ IMX371_REG_REQ_LINK_BIT_RATE_MBPS_H, 798 * 4 },
+	{ IMX371_REG_REQ_LINK_BIT_RATE_MBPS_L, 0 },
+};
+
 static const struct cci_reg_sequence mipi_1308mbps_24mhz_4l[] = {
 	{ CCS_R_EXTCLK_FREQUENCY_MHZ, 0x1800 },
 	{ CCS_R_VT_PIX_CLK_DIV, 5 },
@@ -357,6 +377,86 @@ static const struct cci_reg_sequence mode_4656x3496_regs[] = {
 	{CCI_REG8(0x020F), 0x00},
 };
 
+/*
+ * 2304x1728, 2x2 binning over the whole pixel array (full field of view).
+ * The IMX371 is a quad Bayer sensor: binning its 2x2 same-colour cells
+ * gives an ordinary Bayer image, which the full resolution mode is not
+ * without a remosaic step. Values from the OnePlus 6 stock camera module
+ * configuration (com.qti.sensormodule.liteon_imx371), the mode the stock
+ * camera uses for the front camera preview and video.
+ */
+static const struct cci_reg_sequence mode_2304x1728_regs[] = {
+	{CCI_REG8(0x0112), 0x0A},
+	{CCI_REG8(0x0113), 0x0A},
+	{CCI_REG8(0x0114), 0x03},
+	{CCI_REG8(0x0342), 0x0D},
+	{CCI_REG8(0x0343), 0xA0},
+	{CCI_REG8(0x0340), 0x09},
+	{CCI_REG8(0x0341), 0xF0},
+	{CCI_REG8(0x0344), 0x00},
+	{CCI_REG8(0x0345), 0x00},
+	{CCI_REG8(0x0346), 0x00},
+	{CCI_REG8(0x0347), 0x00},
+	{CCI_REG8(0x0348), 0x12},
+	{CCI_REG8(0x0349), 0x2F},
+	{CCI_REG8(0x034A), 0x0D},
+	{CCI_REG8(0x034B), 0xA7},
