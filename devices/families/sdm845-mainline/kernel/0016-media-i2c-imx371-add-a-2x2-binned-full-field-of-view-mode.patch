+
 /*
  * The supported formats.
  * This table MUST contain 4 entries per format, to cover the various flip
@@ -393,6 +493,7 @@ static const char * const imx371_supply_name[] = {
 
 enum {
 	IMX371_LINK_FREQ_1308MBPS,
+	IMX371_LINK_FREQ_798MBPS,
 };
 
 /*
@@ -419,6 +520,7 @@ static u64 link_freq_to_pixel_rate(u64 f, const struct imx371_link_cfg *link_cfg
 
 static const s64 link_freq_menu_items_24[] = {
 	654000000ULL,
+	399000000ULL,
 };
 
 #define REGS(_list) { .num_of_regs = ARRAY_SIZE(_list), .regs = _list, }
@@ -433,6 +535,15 @@ static const struct imx371_link_freq_config link_freq_configs_24[] = {
 			},
 		}
 	},
+	[IMX371_LINK_FREQ_798MBPS] = {
+		.pixels_per_line = IMX371_PPL_BINNED,
+		.link_cfg = {
+			[IMX371_4_LANE_MODE] = {
+				.lf_to_pix_rate_factor = 4,
+				.reg_list = REGS(mipi_798mbps_24mhz_4l),
+			},
+		}
+	},
 };
 
 static const struct imx371_mode supported_modes[] = {
@@ -453,6 +564,24 @@ static const struct imx371_mode supported_modes[] = {
 			.height = IMX371_PIXEL_ARRAY_HEIGHT,
 		},
 	},
+	{
+		.width = 2304,
+		.height = 1728,
+		.vts_def = IMX371_VTS_BINNED,
+		.vts_min = IMX371_VTS_BINNED,
+		.reg_list = {
+			.num_of_regs = ARRAY_SIZE(mode_2304x1728_regs),
+			.regs = mode_2304x1728_regs,
+		},
+		.link_freq_index = IMX371_LINK_FREQ_798MBPS,
+		/* Binned 12,10 + 2304x1728 digital crop of the whole array */
+		.crop = {
+			.left = 24,
+			.top = 20,
+			.width = 4608,
+			.height = 3456,
+		},
+	},
 };
 
 struct imx371 {
@@ -657,15 +786,28 @@ static int imx371_enum_frame_size(struct v4l2_subdev *sd,
 {
 	struct imx371 *imx371 = to_imx371(sd);
 
-	if (fse->index >= ARRAY_SIZE(supported_modes))
-		return -EINVAL;
+	const struct imx371_mode *mode = NULL;
+	unsigned int i, n = 0;
 
 	if (fse->code != imx371_get_format_code(imx371))
 		return -EINVAL;
 
-	fse->min_width = supported_modes[fse->index].width;
+	/* Skip the modes whose link frequency the firmware doesn't allow. */
+	for (i = 0; i < ARRAY_SIZE(supported_modes); i++) {
+		if (!(imx371->link_freq_bitmap &
+		      BIT(supported_modes[i].link_freq_index)))
+			continue;
+		if (n++ == fse->index) {
+			mode = &supported_modes[i];
+			break;
+		}
+	}
+	if (!mode)
+		return -EINVAL;
+
+	fse->min_width = mode->width;
 	fse->max_width = fse->min_width;
-	fse->min_height = supported_modes[fse->index].height;
+	fse->min_height = mode->height;
 	fse->max_height = fse->min_height;
 
 	return 0;
@@ -731,6 +873,8 @@ static int imx371_set_pad_format(struct v4l2_subdev *sd,
 	mode = v4l2_find_nearest_size(supported_modes,
 		ARRAY_SIZE(supported_modes), width, height,
 		fmt->format.width, fmt->format.height);
+	if (!(imx371->link_freq_bitmap & BIT(mode->link_freq_index)))
+		mode = &supported_modes[0];
 	imx371_update_pad_format(imx371, mode, fmt);
 	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
 		framefmt = v4l2_subdev_state_get_format(sd_state, fmt->pad);
diff --git a/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi b/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi
index b0b508f..e28b495 100644
--- a/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi
@@ -650,7 +650,7 @@
 			imx371_ep: endpoint {
 				remote-endpoint = <&csiphy2_ep>;
 				data-lanes = <1 2 3 4>;
-				link-frequencies = /bits/ 64 <654000000>;
+				link-frequencies = /bits/ 64 <654000000 399000000>;
 			};
 		};
 	};
